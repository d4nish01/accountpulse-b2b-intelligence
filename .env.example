# Backend
# Leave unset to run on a local SQLite file (zero setup).
# docker-compose sets this to PostgreSQL automatically.
DATABASE_URL=postgresql://accountpulse:accountpulse@db:5432/accountpulse

# AI research briefs. Without a key the /briefs endpoint returns a
# template brief instead of failing. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Frontend
VITE_API_BASE=http://localhost:8000
